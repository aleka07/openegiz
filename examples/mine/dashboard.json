  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Baseline digital mine on OpenEgiz: one excavator, two haul trucks, a crusher. Data comes from examples/mine/simulator.py via MQTT -> Ditto -> Telegraf -> InfluxDB.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ore delivered to crusher",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "masst",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3a8c9a"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId == \"org.openegiz.mine:crusher-01\" and r._field == \"value_tonnes_total_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
