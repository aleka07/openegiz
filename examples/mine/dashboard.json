    {
      "id": 9,
      "type": "table",
      "title": "Fleet status",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "payload"
            },
            "properties": [
              {
                "id": "unit",
                "value": "masst"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "speed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fuel"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r.thingId =~ /^org\\.openegiz\\.mine:truck-/ and r._field =~ /^value_(state)_properties_value$/)\n  |> last()\n  |> map(fn: (r) => ({thingId: r.thingId, _value: r._value, _field: strings.trimSuffix(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), suffix: \"_properties_value\")}))\n  |> group(columns: [\"thingId\"])\n  |> pivot(rowKey: [\"thingId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r.thingId =~ /^org\\.openegiz\\.mine:truck-/ and r._field =~ /^value_(payload|speed|fuel|trips_total)_properties_value$/)\n  |> last()\n  |> map(fn: (r) => ({thingId: r.thingId, _value: r._value, _field: strings.trimSuffix(v: strings.trimPrefix(v: r._field, prefix: \"value_\"), suffix: \"_properties_value\")}))\n  |> group(columns: [\"thingId\"])\n  |> pivot(rowKey: [\"thingId\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "thingId",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "thingId": 0,
              "state": 1,
              "payload": 2,
              "speed": 3,
              "fuel": 4,
              "trips_total": 5
            },
            "renameByName": {
              "thingId": "twin",
              "trips_total": "trips"
            }
          }
        }
      ]
    }
