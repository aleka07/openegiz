# =============================================================================
# OpenEgiz — secrets override, TEMPLATE
# =============================================================================
#
# values.yaml deliberately ships INVALID placeholders
# (REPLACE_ME_SEE_SECRETS_VALUES_FILE) for every credential. Real values live
# only on the host, in a file that is never committed:
#
#     ~/openegiz-deploy/secrets.values.yaml     (chmod 600)
#
# How to use this template on a fresh machine:
#
#     mkdir -p ~/openegiz-deploy
#     cp secrets.values.yaml.example ~/openegiz-deploy/secrets.values.yaml
#     chmod 600 ~/openegiz-deploy/secrets.values.yaml
#     # then replace every CHANGE_ME below; generate each one with:
#     openssl rand -base64 18
#
# The file is then passed to every helm operation:
#
#     helm upgrade --install opentwins . -n opentwins --create-namespace \
#       -f ~/openegiz-deploy/secrets.values.yaml
#
# (`make install` / `make upgrade` / `bootstrap.sh` do this for you and refuse
# to run without the file — a hard failure instead of silently restoring the
# upstream defaults ditto/ditto, devops/foobar, admin/admin.)
#
# NEVER commit the filled-in file. This `.example` is the only version that
# belongs in git. Keep a human-readable copy of the generated credentials on
# the host only, e.g. ~/course/CREDENTIALS.md (chmod 600).
#
# Two of these are applied ONLY at first bootstrap — see the notes below.
# -----------------------------------------------------------------------------

ditto:
  global:
    basicAuthUsers:
      ditto:
        # DO NOT CHANGE. The post-install hooks build the Ditto connections with
        # authorizationContext "nginx:<user>" hardcoded as "nginx:ditto"
        # (post-install/ditto-mosquitto-connection/*.json). Renaming this user
        # silently breaks both MQTT connections.
        user: ditto
        # Ditto REST API password (curl -u ditto:… :30525/api/2/things).
        password: CHANGE_ME
      devops:
        # DO NOT CHANGE — same reasoning; also used by templates/fixers/ditto-fixer.yaml.
        user: devops
        # Ditto devops password for nginx basic auth (:30525/status/health).
        password: CHANGE_ME
  gateway:
    config:
      authentication:
        devops:
          # Ditto gateway's own devops API password (/devops/piggyback/*).
          devopsPassword: CHANGE_ME
          # Ditto gateway's own status API password (/devops/logging, /status).
          statusPassword: CHANGE_ME

grafana:
  # Grafana admin password for user "admin" (:30718). Applied at FIRST START only:
  # Grafana then keeps it in its own DB on the PVC, so changing this value later
  # does nothing — use `grafana cli admin reset-admin-password` instead.
  adminPassword: CHANGE_ME

influxdb2:
  adminUser:
    # InfluxDB2 admin password for user "admin" (:30716, org opentwins, bucket default).
    # Applied at FIRST BOOTSTRAP only (the subchart seeds it into the PVC);
    # on a running instance change it through the influx CLI/API as well.
    password: CHANGE_ME
    # InfluxDB2 admin token. Consumed by templates/config-maps/cm-telegraf.yaml
    # and cm-influxdb-grafana-datasource.yaml, so a wrong value breaks telemetry
    # ingest and the Grafana datasource. Also first-bootstrap only.
    token: CHANGE_ME
